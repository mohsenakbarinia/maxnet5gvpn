[
  {
    "name": "valid_vless_reality_tcp",
    "raw": "vless://a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d@example.com:443?encryption=none&flow=xtls-rprx-vision&security=reality&sni=test.example.com&fp=chrome&pbk=1111111111111111111111111111111111111111111&sid=0123456789abcdef&type=tcp#TestRemark",
    "should_parse": true,
    "expected_protocol": "VLESS",
    "expected_host": "example.com",
    "expected_port": 443,
    "expected_security": "reality",
    "expected_network": "tcp"
  },
  {
    "name": "valid_vless_ws_tls",
    "raw": "vless://b2c3d4e5-f6a7-8b9c-0d1e-2f3a4b5c6d7e@node2.cloud.net:8443?encryption=none&security=tls&sni=node2.cloud.net&type=ws&path=%2Fchat%2Fstream&host=node2.cloud.net&fp=firefox&alpn=h2,http/1.1#WS_Node",
    "should_parse": true,
    "expected_protocol": "VLESS",
    "expected_host": "node2.cloud.net",
    "expected_port": 8443,
    "expected_security": "tls",
    "expected_network": "ws"
  },
  {
    "name": "valid_vmess_json_b64",
    "raw": "vmess:",
    "should_parse": true,
    "expected_protocol": "VMESS",
    "expected_host": "vmess.node.io",
    "expected_port": 443,
    "expected_security": "tls",
    "expected_network": "ws"
  },
  {
    "name": "valid_trojan_grpc_tls",
    "raw": "trojan://SecretP@ssw0rd!@trojan.relay.org:443?security=tls&sni=trojan.relay.org&type=grpc&serviceName=TrojanService&fp=edge#TrojanRelay",
    "should_parse": true,
    "expected_protocol": "TROJAN",
    "expected_host": "trojan.relay.org",
    "expected_port": 443,
    "expected_security": "tls",
    "expected_network": "grpc"
  },
  {
    "name": "unsupported_shadowsocks",
