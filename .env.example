# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# FREE_VPN_SUBSCRIPTION_URL: Dedicated exclusive subscription endpoint for MAXNET5G Free VPN.
# Configure this secret in the AI Studio Secrets panel or local .env (never commit actual credentials).
FREE_VPN_SUBSCRIPTION_URL=YOUR_FREE_VPN_SUBSCRIPTION_URL
